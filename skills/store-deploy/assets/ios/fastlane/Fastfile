default_platform(:ios)

# Flutter가 만든 IPA 검색 경로 (ios/에서 상대경로)
IPA_GLOB = "../build/ios/ipa/*.ipa"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"],
    in_house: false
  )
end

def resolved_ipa
  ipa = Dir.glob(IPA_GLOB).max_by { |f| File.mtime(f) }
  UI.user_error!("IPA를 찾을 수 없습니다. 먼저 `flutter build ipa --release` 실행") unless ipa
  ipa
end

platform :ios do
  desc "빌드는 CI/로컬에서 `flutter build ipa --release`로 먼저 수행할 것"

  desc "TestFlight 업로드 (베타/안전 확인용)"
  lane :beta do
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: resolved_ipa,
      skip_waiting_for_build_processing: true
    )
  end

  desc "App Store 업로드 + 심사 제출 + 통과 시 자동 출시"
  lane :production do
    upload_to_app_store(
      api_key: asc_api_key,
      ipa: resolved_ipa,
      submit_for_review: true,
      automatic_release: true,
      force: true,                      # HTML 프리뷰 없이 진행(CI)
      skip_metadata: true,              # 메타데이터는 App Store Connect에서 관리
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false    # 앱이 IDFA/광고 추적 사용 시 true로
      }
    )
  end
end
